# ─── Server-side (never exposed to the browser) ──────────────────────────────

# Private key of the wallet that owns the ExpertWhitelist contract.
# This address must be the same one used during `forge script --broadcast`.
# Format: 0x followed by 64 hex chars.
OWNER_PRIVATE_KEY=0x...

# JSON-RPC URL for the target network (Polygon Amoy testnet by default).
# Get a free one from Alchemy / Infura / Ankr.
RPC_URL=https://rpc-amoy.polygon.technology

# Address of the deployed ExpertWhitelist contract (from forge script output).
EXPERT_WHITELIST_ADDRESS=0x...

# ─── Client-side (safe to expose, must be NEXT_PUBLIC_ prefixed) ─────────────

# WalletConnect project ID — create a free project at https://cloud.walletconnect.com
NEXT_PUBLIC_WALLET_CONNECT_PROJECT_ID=your_project_id_here

# Same contract address as above — needed by wagmi hooks in the browser.
NEXT_PUBLIC_EXPERT_WHITELIST_ADDRESS=0x...

# Chain ID for the target network.
# 80002 = Polygon Amoy testnet  |  137 = Polygon mainnet
NEXT_PUBLIC_CHAIN_ID=80002
